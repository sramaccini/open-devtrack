{
  "schemaVersion": "1.0",
  "datasources": "projects",
  "description": "Projects of the workspace, their members and their workflow (modules project and workflow), and their custom fields (module issue).",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects",
      "body": "{{form}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}",
      "body": "{{form}}"
    },
    "members": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/members"
    },
    "addMember": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/members",
      "body": "{{form}}"
    },
    "changeRole": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/members/{{username}}",
      "body": "{{form}}"
    },
    "removeMember": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/members/{{username}}"
    },
    "workflows": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/workflows"
    },
    "addWorkflow": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/workflows",
      "body": "{{form}}"
    },
    "removeWorkflow": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/workflows/{{id}}",
      "params": {
        "version": "{{version}}"
      }
    },
    "fieldDefinitions": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/field-definitions"
    },
    "addField": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/field-definitions",
      "body": "{{form}}"
    },
    "saveField": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/field-definitions/{{fieldKey}}",
      "body": "{{form}}"
    },
    "useScheme": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/permission-scheme",
      "body": "{{form}}"
    },
    "groups": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/groups"
    },
    "addGroup": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/groups",
      "body": "{{form}}"
    },
    "removeGroup": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/groups/{{group}}"
    }
  }
}
