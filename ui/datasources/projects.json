{
  "schemaVersion": "1.0",
  "datasources": "projects",
  "description": "Projects of the workspace, their members and their workflow (modules project and workflow), and their custom fields (module issue).",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects",
      "body": "{{formFields}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}",
      "body": {
        "name": "{{formFields.name}}",
        "lead": "{{formFields.lead}}",
        "description": "{{formFields.description}}",
        "version": "{{form.version}}"
      }
    },
    "members": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/members"
    },
    "addMember": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/members",
      "body": "{{formFields}}"
    },
    "changeRole": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/members/{{username}}",
      "body": "{{formFields}}"
    },
    "removeMember": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/members/{{username}}"
    },
    "workflows": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/workflows"
    },
    "addWorkflow": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/workflows",
      "body": "{{formFields}}"
    },
    "removeWorkflow": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/workflows/{{id}}",
      "params": {
        "version": "{{version}}"
      }
    },
    "fieldDefinitions": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/field-definitions"
    },
    "addField": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/field-definitions",
      "body": "{{formFields}}"
    },
    "saveField": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/field-definitions/{{fieldKey}}",
      "body": {
        "label": "{{formFields.label}}",
        "options": "{{formFields.options}}",
        "requiredIf": "{{formFields.requiredIf}}",
        "archived": "{{formFields.archived}}",
        "version": "{{form.version}}"
      }
    },
    "useScheme": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/projects/{{params.key}}/permission-scheme",
      "body": "{{formFields}}"
    },
    "groups": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/groups"
    },
    "addGroup": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/groups",
      "body": {
        "group": "{{form.group}}",
        "role": "{{formFields.role}}"
      }
    },
    "removeGroup": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/projects/{{params.key}}/groups/{{group}}"
    },
    "log": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/admin-events"
    },
    "creatable": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects",
      "params": {
        "q": "{{ search }}",
        "creatable": "true"
      }
    }
  }
}
