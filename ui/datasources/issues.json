{
  "schemaVersion": "1.0",
  "datasources": "issues",
  "description": "Issues of a project (module issue) with their custom fields, attachments, links, watchers, flag, votes and transitions (module workflow), the members who can be assigned, the comments and the work log (module collaboration) and the changelog (module audit).",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/issues"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/issues",
      "body": "{{formFields}}"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}",
      "body": {
        "summary": "{{formFields.summary}}",
        "type": "{{formFields.type}}",
        "priority": "{{formFields.priority}}",
        "assignee": "{{formFields.assignee}}",
        "reviewer": "{{formFields.reviewer}}",
        "startOn": "{{formFields.startOn}}",
        "dueOn": "{{formFields.dueOn}}",
        "labels": "{{formFields.labels}}",
        "description": "{{formFields.description}}",
        "custom": "{{formFields.custom}}",
        "version": "{{form.version}}"
      }
    },
    "patch": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/issues/{{params.issue}}",
      "body": "{{ field == 'parentKey' ? dyn({'parent': value, 'version': form.version}) : field.startsWith('custom.') ? dyn({'custom': form.custom, 'version': form.version}) : dyn({string(field): value, 'version': form.version}) }}"
    },
    "clone": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/clone",
      "body": {
        "summary": "{{form.summary}}"
      }
    },
    "moveToProject": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/move",
      "body": {
        "project": "{{target}}",
        "type": "{{issueType}}",
        "status": "{{targetStatus}}",
        "version": "{{version}}",
        "fields": {
          "drop": "{{drop}}"
        },
        "dryRun": "{{dryRun}}"
      }
    },
    "moveTargets": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/move/targets",
      "params": {
        "q": "{{search}}"
      }
    },
    "moveStatuses": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/move/statuses",
      "params": {
        "project": "{{form.project}}",
        "type": "{{form.type}}"
      }
    },
    "share": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/share",
      "body": {
        "users": "{{form.users}}",
        "message": "{{form.message}}"
      }
    },
    "export": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/export?format={{format}}"
    },
    "remove": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}"
    },
    "assignees": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/members",
      "params": {
        "q": "{{search}}"
      }
    },
    "labels": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/labels",
      "params": {
        "q": "{{ search }}"
      }
    },
    "comments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/comments"
    },
    "addComment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/comments",
      "body": {
        "body": "{{text}}"
      }
    },
    "editComment": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}",
      "body": {
        "body": "{{text}}",
        "version": "{{version}}"
      }
    },
    "removeComment": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}"
    },
    "attachments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/attachments"
    },
    "uploadAttachment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/attachments"
    },
    "removeAttachment": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/attachments/{{id}}"
    },
    "history": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/history"
    },
    "transitions": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/transitions"
    },
    "workflow": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/workflow"
    },
    "move": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/transitions",
      "body": {
        "transition": "{{transition}}",
        "version": "{{version}}"
      }
    },
    "links": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links"
    },
    "linkCandidates": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links/candidates",
      "params": {
        "q": "{{search}}"
      }
    },
    "addLink": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/links",
      "body": "{{formFields}}"
    },
    "removeLink": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/links/{{id}}"
    },
    "watchers": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/watchers"
    },
    "watch": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/watchers",
      "body": {
        "username": "me"
      }
    },
    "addWatcher": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/watchers",
      "body": "{{formFields}}"
    },
    "flag": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/flag"
    },
    "unflag": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/flag"
    },
    "votes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/votes"
    },
    "vote": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/votes"
    },
    "unvote": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/votes/me"
    },
    "unwatch": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/watchers/{{username}}"
    },
    "newFields": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/fields"
    },
    "fields": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/fields"
    },
    "children": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/children"
    },
    "parents": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/parents",
      "params": {
        "type": "{{data.issue.type}}",
        "q": "{{search}}",
        "exclude": "{{params.issue}}"
      }
    },
    "newParents": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/parents",
      "params": {
        "type": "{{form.type}}",
        "q": "{{search}}"
      }
    },
    "addChild": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/issues",
      "body": {
        "type": "{{childType}}",
        "summary": "{{summary}}",
        "parent": "{{params.issue}}"
      }
    },
    "epics": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/epics",
      "params": {
        "q": "{{search}}"
      }
    },
    "setEpic": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/epic",
      "body": {
        "issues": "{{issues}}",
        "epic": "{{epic}}"
      }
    },
    "linkRelations": {
      "type": "rest",
      "method": "GET",
      "url": "/api/link-types/relations",
      "params": {
        "q": "{{search}}"
      }
    },
    "assign": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/issues/{{params.issue}}",
      "body": {
        "assignee": "{{assignee}}",
        "version": "{{version}}"
      }
    },
    "quickCreate": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{formFields.project}}/issues",
      "body": {
        "summary": "{{formFields.summary}}",
        "type": "{{formFields.type}}"
      }
    },
    "activity": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/activity"
    },
    "worklogs": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/worklogs"
    },
    "addWorkLog": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/worklogs",
      "body": {
        "timeSpent": "{{form.timeSpent}}",
        "started": "{{form.started}}",
        "comment": "{{form.comment}}",
        "remainingEstimate": "{{form.remainingEstimate}}"
      }
    },
    "editWorkLog": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/worklogs/{{id}}",
      "body": {
        "timeSpent": "{{form.timeSpent}}",
        "started": "{{form.started}}",
        "comment": "{{form.comment}}",
        "remainingEstimate": "{{form.remainingEstimate}}",
        "version": "{{version}}"
      }
    },
    "removeWorkLog": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/worklogs/{{id}}"
    },
    "timeTracking": {
      "type": "rest",
      "method": "GET",
      "url": "/api/time-tracking"
    }
  }
}
