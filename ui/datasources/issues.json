{
  "schemaVersion": "1.0",
  "datasources": "issues",
  "description": "Issues of a project (module issue) with their links and transitions (module workflow), the members who can be assigned, the comments (module collaboration) and the changelog (module audit).",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/issues"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/issues",
      "body": "{{form}}"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}",
      "body": "{{form}}"
    },
    "remove": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}"
    },
    "assignees": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/members",
      "params": {
        "q": "{{search}}"
      }
    },
    "comments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/comments"
    },
    "addComment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/comments",
      "body": "{{form}}"
    },
    "editComment": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}",
      "body": "{{form}}"
    },
    "removeComment": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}"
    },
    "history": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/history"
    },
    "transitions": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/transitions"
    },
    "move": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/transitions",
      "body": {
        "transition": "{{transition}}",
        "version": "{{version}}"
      }
    },
    "links": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links"
    },
    "linkCandidates": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links/candidates",
      "params": {
        "q": "{{search}}"
      }
    },
    "addLink": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/links",
      "body": "{{form}}"
    },
    "removeLink": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/links/{{id}}"
    }
  }
}
