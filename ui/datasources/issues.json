{
  "schemaVersion": "1.0",
  "datasources": "issues",
  "description": "Issues of a project (module issue) with their custom fields, attachments, links, watchers, flag, votes and transitions (module workflow), the members who can be assigned, the comments (module collaboration) and the changelog (module audit).",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/issues"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/issues",
      "body": "{{formFields}}"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}",
      "body": {
        "summary": "{{formFields.summary}}",
        "type": "{{formFields.type}}",
        "priority": "{{formFields.priority}}",
        "assignee": "{{formFields.assignee}}",
        "reviewer": "{{formFields.reviewer}}",
        "dueOn": "{{formFields.dueOn}}",
        "labels": "{{formFields.labels}}",
        "description": "{{formFields.description}}",
        "custom": "{{formFields.custom}}",
        "version": "{{form.version}}"
      }
    },
    "patch": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/issues/{{params.issue}}",
      "body": "{{ field.startsWith('custom.') ? dyn({'custom': form.custom, 'version': form.version}) : dyn({string(field): value, 'version': form.version}) }}"
    },
    "assignToMe": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/issues/{{params.issue}}",
      "body": "{{ dyn({'assignee': user.username, 'version': data.issue.version}) }}"
    },
    "clone": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/clone",
      "body": {
        "summary": "{{form.summary}}"
      }
    },
    "share": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/share",
      "body": {
        "users": "{{form.users}}",
        "message": "{{form.message}}"
      }
    },
    "remove": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}"
    },
    "assignees": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/members",
      "params": {
        "q": "{{search}}"
      }
    },
    "labels": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/labels",
      "params": {
        "q": "{{ search }}"
      }
    },
    "comments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/comments"
    },
    "addComment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/comments",
      "body": {
        "body": "{{text}}"
      }
    },
    "editComment": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}",
      "body": {
        "body": "{{text}}",
        "version": "{{version}}"
      }
    },
    "removeComment": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/comments/{{id}}"
    },
    "attachments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/attachments"
    },
    "uploadAttachment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/attachments"
    },
    "removeAttachment": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/attachments/{{id}}"
    },
    "history": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/history"
    },
    "transitions": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/transitions"
    },
    "workflow": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/workflow"
    },
    "move": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/transitions",
      "body": {
        "transition": "{{transition}}",
        "version": "{{version}}"
      }
    },
    "links": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links"
    },
    "linkCandidates": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/links/candidates",
      "params": {
        "q": "{{search}}"
      }
    },
    "addLink": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/links",
      "body": "{{formFields}}"
    },
    "removeLink": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/links/{{id}}"
    },
    "watchers": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/watchers"
    },
    "watch": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/watchers",
      "body": {
        "username": "me"
      }
    },
    "addWatcher": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/watchers",
      "body": "{{formFields}}"
    },
    "flag": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/flag"
    },
    "unflag": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/flag"
    },
    "votes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/votes"
    },
    "vote": {
      "type": "rest",
      "method": "POST",
      "url": "/api/issues/{{params.issue}}/votes"
    },
    "unvote": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/votes/me"
    },
    "unwatch": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/issues/{{params.issue}}/watchers/{{username}}"
    },
    "newFields": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/fields"
    },
    "fields": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/fields"
    }
  }
}
