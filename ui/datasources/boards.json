{
  "schemaVersion": "1.0",
  "datasources": "boards",
  "description": "Boards, backlog and sprints of the projects (module agile, ADR-15, ADR-26).",
  "sources": {
    "mine": {
      "type": "rest",
      "method": "GET",
      "url": "/api/boards"
    },
    "ofProject": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/boards"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/boards",
      "body": "{{formFields}}"
    },
    "save": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/boards/{{id}}",
      "body": {
        "name": "{{formFields.name}}",
        "kind": "{{formFields.kind}}",
        "lane": "{{formFields.lane}}",
        "columns": "{{formFields.columns}}",
        "filter": "{{formFields.filter}}",
        "version": "{{form.version}}"
      }
    },
    "remove": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/boards/{{id}}"
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/api/boards/{{params.board}}"
    },
    "columns": {
      "type": "rest",
      "method": "GET",
      "url": "/api/boards/{{params.board}}/columns"
    },
    "cards": {
      "type": "rest",
      "method": "GET",
      "url": "/api/boards/{{params.board}}/cards"
    },
    "move": {
      "type": "rest",
      "method": "POST",
      "url": "/api/boards/{{params.board}}/cards/{{key}}/move",
      "body": {
        "column": "{{to}}",
        "beforeId": "{{beforeId}}",
        "afterId": "{{afterId}}",
        "lane": "{{lane}}"
      }
    },
    "planColumns": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{row.project}}/backlog/columns"
    },
    "projectColumns": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/backlog/columns"
    },
    "backlogPlan": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{project}}/backlog/cards/{{key}}/move",
      "body": {
        "column": "{{column}}",
        "to": "{{to}}"
      }
    },
    "backlogPlanMany": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{project}}/backlog/plan",
      "body": {
        "issues": "{{issues}}",
        "column": "{{column}}"
      }
    },
    "sprints": {
      "type": "rest",
      "method": "GET",
      "url": "/api/projects/{{params.key}}/sprints"
    },
    "createSprint": {
      "type": "rest",
      "method": "POST",
      "url": "/api/projects/{{params.key}}/sprints",
      "body": "{{formFields}}"
    },
    "saveSprint": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/sprints/{{id}}",
      "body": {
        "name": "{{formFields.name}}",
        "goal": "{{formFields.goal}}",
        "startsOn": "{{formFields.startsOn}}",
        "endsOn": "{{formFields.endsOn}}",
        "version": "{{form.version}}"
      }
    },
    "startSprint": {
      "type": "rest",
      "method": "POST",
      "url": "/api/sprints/{{id}}/start",
      "body": "{{formFields}}"
    },
    "completeSprint": {
      "type": "rest",
      "method": "POST",
      "url": "/api/sprints/{{id}}/complete",
      "body": "{{formFields}}"
    },
    "removeSprint": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/sprints/{{id}}"
    },
    "plan": {
      "type": "rest",
      "method": "GET",
      "url": "/api/issues/{{params.issue}}/plan"
    },
    "savePlan": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/issues/{{params.issue}}/plan",
      "body": {
        "points": "{{formFields.points}}"
      }
    }
  }
}
