{
  "schemaVersion": "1.0",
  "datasources": "admin",
  "description": "The administration (ADR-22): users, roles, tenants, the audit of access and the sessions of authz-library; the permission schemes of OpenDevTrack.",
  "sources": {
    "users": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/tenants/{{user.tenant}}/users",
      "params": {
        "limit": 500
      }
    },
    "createUser": {
      "type": "rest",
      "method": "POST",
      "url": "/api/v1/admin/users",
      "body": {
        "username": "{{username}}",
        "email": "{{email}}"
      }
    },
    "assignRoles": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/v1/admin/tenants/{{user.tenant}}/users/{{username}}/roles",
      "body": {
        "roles": "{{roles}}"
      }
    },
    "changeUser": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/v1/admin/users/{{username}}",
      "body": {
        "active": "{{active}}"
      }
    },
    "signOut": {
      "type": "rest",
      "method": "DELETE",
      "url": "/bff/admin/users/{{username}}/sessions"
    },
    "roles": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/roles"
    },
    "saveRole": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/v1/admin/roles/{{code}}",
      "body": "{{form}}"
    },
    "tenants": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/tenants"
    },
    "createTenant": {
      "type": "rest",
      "method": "POST",
      "url": "/api/v1/admin/tenants",
      "body": "{{form}}"
    },
    "audit": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/audit",
      "params": {
        "limit": 200
      }
    },
    "schemes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/permission-schemes"
    },
    "addScheme": {
      "type": "rest",
      "method": "POST",
      "url": "/api/permission-schemes",
      "body": "{{form}}"
    },
    "saveScheme": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/permission-schemes/{{id}}",
      "body": "{{form}}"
    },
    "removeScheme": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/permission-schemes/{{id}}"
    }
  }
}
