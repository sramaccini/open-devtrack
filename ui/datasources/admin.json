{
  "schemaVersion": "1.0",
  "datasources": "admin",
  "description": "The administration (ADR-22): users, roles, tenants, the audit of access and the sessions of authz-library; the export and the removal of a user (ADR-24, O13); the permission schemes and the groups of OpenDevTrack.",
  "sources": {
    "users": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/tenants/{{user.tenant}}/users",
      "params": {
        "limit": 500
      }
    },
    "createUser": {
      "type": "rest",
      "method": "POST",
      "url": "/api/v1/admin/users",
      "body": {
        "username": "{{username}}",
        "email": "{{email}}"
      }
    },
    "assignRoles": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/v1/admin/tenants/{{user.tenant}}/users/{{username}}/roles",
      "body": {
        "roles": "{{roles}}"
      }
    },
    "changeUser": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/v1/admin/users/{{username}}",
      "body": {
        "active": "{{active}}"
      }
    },
    "signOut": {
      "type": "rest",
      "method": "DELETE",
      "url": "/bff/admin/users/{{username}}/sessions"
    },
    "exportUser": {
      "type": "rest",
      "method": "GET",
      "url": "/api/admin/users/{{username}}/export"
    },
    "removeUser": {
      "type": "rest",
      "method": "POST",
      "url": "/api/admin/users/{{username}}/remove",
      "body": {
        "confirm": "{{confirm}}"
      }
    },
    "roles": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/roles"
    },
    "saveRole": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/v1/admin/roles/{{code}}",
      "body": {
        "description": "{{formFields.description}}",
        "permissions": "{{formFields.permissions}}",
        "version": "{{form.version}}"
      }
    },
    "tenants": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/tenants"
    },
    "createTenant": {
      "type": "rest",
      "method": "POST",
      "url": "/api/v1/admin/tenants",
      "body": "{{formFields}}"
    },
    "audit": {
      "type": "rest",
      "method": "GET",
      "url": "/api/v1/admin/audit",
      "params": {
        "limit": 200
      }
    },
    "schemes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/permission-schemes"
    },
    "addScheme": {
      "type": "rest",
      "method": "POST",
      "url": "/api/permission-schemes",
      "body": "{{formFields}}"
    },
    "saveScheme": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/permission-schemes/{{id}}",
      "body": {
        "name": "{{formFields.name}}",
        "description": "{{formFields.description}}",
        "viewer": "{{formFields.viewer}}",
        "developer": "{{formFields.developer}}",
        "admin": "{{formFields.admin}}",
        "version": "{{form.version}}"
      }
    },
    "removeScheme": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/permission-schemes/{{id}}"
    },
    "groups": {
      "type": "rest",
      "method": "GET",
      "url": "/api/groups",
      "params": {
        "q": "{{search}}"
      }
    },
    "group": {
      "type": "rest",
      "method": "GET",
      "url": "/api/groups/{{params.id}}"
    },
    "addGroup": {
      "type": "rest",
      "method": "POST",
      "url": "/api/groups",
      "body": "{{formFields}}"
    },
    "saveGroup": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/groups/{{id}}",
      "body": {
        "name": "{{formFields.name}}",
        "description": "{{formFields.description}}",
        "version": "{{form.version}}"
      }
    },
    "removeGroup": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/groups/{{id}}"
    },
    "groupMembers": {
      "type": "rest",
      "method": "GET",
      "url": "/api/groups/{{params.id}}/members"
    },
    "addGroupMember": {
      "type": "rest",
      "method": "POST",
      "url": "/api/groups/{{params.id}}/members",
      "body": "{{formFields}}"
    },
    "removeGroupMember": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/groups/{{params.id}}/members/{{username}}"
    },
    "configLog": {
      "type": "rest",
      "method": "GET",
      "url": "/api/admin-events",
      "params": {
        "project": "{{ state.project }}",
        "actor": "{{ state.actor }}",
        "action": "{{ state.action }}",
        "from": "{{ state.from }}",
        "to": "{{ state.to }}"
      }
    },
    "linkTypes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/link-types"
    },
    "addLinkType": {
      "type": "rest",
      "method": "POST",
      "url": "/api/link-types",
      "body": "{{formFields}}"
    },
    "saveLinkType": {
      "type": "rest",
      "method": "PATCH",
      "url": "/api/link-types/{{code}}",
      "body": {
        "outward": "{{formFields.outward}}",
        "inward": "{{formFields.inward}}",
        "version": "{{form.version}}"
      }
    },
    "removeLinkType": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/link-types/{{code}}",
      "params": {
        "replaceWith": "{{replaceWith}}",
        "deleteLinks": "{{deleteLinks}}"
      }
    },
    "otherLinkTypes": {
      "type": "rest",
      "method": "GET",
      "url": "/api/link-types",
      "params": {
        "except": "{{row.code}}"
      }
    },
    "teams": {
      "type": "rest",
      "method": "GET",
      "url": "/api/teams",
      "params": {
        "q": "{{search}}"
      }
    },
    "team": {
      "type": "rest",
      "method": "GET",
      "url": "/api/teams/{{params.id}}"
    },
    "addTeam": {
      "type": "rest",
      "method": "POST",
      "url": "/api/teams",
      "body": "{{formFields}}"
    },
    "saveTeam": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/teams/{{id}}",
      "body": {
        "name": "{{formFields.name}}",
        "description": "{{formFields.description}}",
        "lead": "{{formFields.lead}}",
        "version": "{{form.version}}"
      }
    },
    "removeTeam": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/teams/{{id}}"
    },
    "teamMembers": {
      "type": "rest",
      "method": "GET",
      "url": "/api/teams/{{params.id}}/members"
    },
    "addTeamMember": {
      "type": "rest",
      "method": "POST",
      "url": "/api/teams/{{params.id}}/members",
      "body": "{{formFields}}"
    },
    "removeTeamMember": {
      "type": "rest",
      "method": "DELETE",
      "url": "/api/teams/{{params.id}}/members/{{username}}"
    }
  }
}
