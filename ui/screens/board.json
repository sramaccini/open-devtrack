{
  "schemaVersion": "1.0",
  "screen": "board",
  "title": "{{ t('agile.board', 'Board') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "board": {
      "ref": "boards/get"
    },
    "columns": {
      "ref": "boards/columns"
    },
    "cards": {
      "ref": "boards/cards"
    },
    "move": {
      "ref": "boards/move"
    }
  },
  "components": [
    {
      "id": "board-summary",
      "type": "form",
      "layout": "flow",
      "source": "board",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "label": "{{ t('agile.board_name', 'Board') }}",
          "width": "m",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "projectName",
          "type": "text",
          "label": "{{ t('agile.project', 'Project') }}",
          "width": "m",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "sprint",
          "type": "text",
          "label": "{{ t('agile.active_sprint', 'Active sprint') }}",
          "width": "m",
          "visibleIf": "{{ form.kind == \"scrum\" }}",
          "readOnlyIf": "{{true}}",
          "tooltip": "{{ t('agile.active_sprint_help', 'A scrum board shows the issues of the active sprint') }}"
        },
        {
          "name": "filter",
          "type": "text",
          "label": "{{ t('agile.board_filter', 'Filter') }}",
          "visibleIf": "{{ form.filter != null }}",
          "readOnlyIf": "{{true}}",
          "tooltip": "{{ t('agile.board_filter_shown', 'Only the issues this ODQL query finds are on the board') }}"
        }
      ],
      "actions": [
        {
          "id": "btn-backlog",
          "label": "{{ t('agile.backlog', 'Backlog') }}",
          "onClick": [
            {
              "navigate": "backlog",
              "params": {
                "key": "{{form.project}}"
              }
            }
          ]
        },
        {
          "id": "btn-issues",
          "label": "{{ t('issues.title', 'Issues') }}",
          "onClick": [
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{form.project}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "board-no-sprint",
      "type": "alert",
      "visibleIf": "{{ data.board.kind == \"scrum\" && data.board.sprint == null }}",
      "text": "{{ t('agile.no_active_sprint', 'No sprint is active: start one from the backlog') }}"
    },
    {
      "id": "board-kanban",
      "type": "kanban",
      "source": "cards",
      "columnField": "column",
      "titleField": "summary",
      "descriptionField": "key",
      "keyField": "key",
      "avatarField": "assignee",
      "badges": [
        {
          "field": "type",
          "valueKey": "values.issue_type"
        },
        {
          "field": "priority",
          "valueKey": "values.priority",
          "tones": {
            "highest": "danger",
            "high": "danger",
            "low": "neutral",
            "lowest": "neutral"
          }
        }
      ],
      "footerFields": [
        {
          "field": "points",
          "label": "{{ t('agile.points_short', 'Points') }}"
        }
      ],
      "columnsFrom": {
        "source": "columns",
        "valueField": "value",
        "labelField": "label",
        "toneField": "tone",
        "limitField": "limit"
      },
      "laneField": "{{ data.board != null && data.board.lane != 'none' ? data.board.lane : '' }}",
      "lanes": "{{ data.board != null && data.board.lane == 'priority' ? [{'value': 'highest', 'label': t('values.priority.highest', 'Highest')}, {'value': 'high', 'label': t('values.priority.high', 'High')}, {'value': 'medium', 'label': t('values.priority.medium', 'Medium')}, {'value': 'low', 'label': t('values.priority.low', 'Low')}, {'value': 'lowest', 'label': t('values.priority.lowest', 'Lowest')}] : data.board != null && data.board.lane == 'type' ? [{'value': 'epic', 'label': t('values.issue_type.epic', 'Epic')}, {'value': 'story', 'label': t('values.issue_type.story', 'Story')}, {'value': 'task', 'label': t('values.issue_type.task', 'Task')}, {'value': 'bug', 'label': t('values.issue_type.bug', 'Bug')}] : [] }}",
      "reorder": true,
      "moveIf": "{{ row._perm.move }}",
      "onMove": [
        {
          "call": "move",
          "args": {
            "key": "{{row.key}}",
            "to": "{{to}}",
            "beforeId": "{{beforeId}}",
            "afterId": "{{afterId}}"
          },
          "onError": [
            {
              "if": "{{error.status == 409}}",
              "then": [
                {
                  "toast": "{{ t('agile.no_transition', 'No step of the workflow leads there now: check its conditions') }}"
                }
              ],
              "else": [
                {
                  "toast": "{{ t('agile.move_failed', 'The card could not be moved') }}"
                }
              ]
            },
            {
              "refresh": "cards"
            }
          ]
        },
        {
          "refresh": "cards"
        }
      ],
      "onOpen": [
        {
          "navigate": "issue-detail",
          "params": {
            "key": "{{data.board.project}}",
            "issue": "{{row.key}}"
          }
        }
      ]
    }
  ]
}
