{
  "schemaVersion": "1.0",
  "screen": "issue-new",
  "title": "{{ t('issues.new', 'New issue') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "create": {
      "ref": "issues/create"
    },
    "assignees": {
      "ref": "issues/assignees"
    },
    "labels": {
      "ref": "issues/labels"
    },
    "newFields": {
      "ref": "issues/newFields"
    }
  },
  "components": [
    {
      "id": "issue-form",
      "type": "form",
      "layout": "flow",
      "initial": {
        "type": "task",
        "priority": "medium"
      },
      "fields": [
        {
          "name": "summary",
          "type": "text",
          "label": "{{ t('issues.summary', 'Summary') }}",
          "width": "l",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "type",
          "type": "select",
          "label": "{{ t('issues.type', 'Type') }}",
          "width": "s",
          "options": [
            "task",
            "bug",
            "story",
            "epic"
          ],
          "optionKey": "values.issue_type",
          "required": true
        },
        {
          "name": "priority",
          "type": "select",
          "label": "{{ t('issues.priority', 'Priority') }}",
          "width": "s",
          "options": [
            "lowest",
            "low",
            "medium",
            "high",
            "highest"
          ],
          "optionKey": "values.priority",
          "required": true
        },
        {
          "name": "assignee",
          "type": "lookup",
          "label": "{{ t('issues.assignee', 'Assignee') }}",
          "width": "m",
          "tooltip": "{{ t('issues.assignee_help', 'A member of the project') }}",
          "lookup": {
            "source": "assignees",
            "valueField": "username",
            "labelField": "username",
            "minChars": 0
          }
        },
        {
          "name": "reviewer",
          "type": "lookup",
          "label": "{{ t('issues.reviewer', 'Reviewer') }}",
          "width": "m",
          "tooltip": "{{ t('issues.reviewer_help', 'A member of the project other than the assignee') }}",
          "lookup": {
            "source": "assignees",
            "valueField": "username",
            "labelField": "username",
            "minChars": 0
          }
        },
        {
          "name": "dueOn",
          "type": "date",
          "label": "{{ t('issues.due_on', 'Due date') }}",
          "width": "s",
          "tooltip": "{{ t('issues.due_on_help', 'The day it should be done; past it, and not done, the issue is overdue') }}"
        },
        {
          "name": "labels",
          "type": "tags",
          "label": "{{ t('issues.labels', 'Labels') }}",
          "maxItems": 20,
          "suggest": {
            "source": "labels",
            "valueField": "name"
          },
          "tooltip": "{{ t('issues.labels_help', 'Lower case letters, digits, dots, dashes or underscores; Enter or a comma adds one') }}"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "{{ t('issues.description', 'Description') }}",
          "rows": 8
        }
      ],
      "actions": [
        {
          "id": "btn-create",
          "label": "{{ t('issues.create', 'Create issue') }}",
          "onClick": [
            {
              "call": "create",
              "as": "created",
              "onError": [
                {
                  "if": "{{error.fields > 0}}",
                  "then": [
                    {
                      "toast": "{{ t('common.check_fields', 'Check the highlighted fields') }}"
                    }
                  ],
                  "else": [
                    {
                      "if": "{{error.status == 403}}",
                      "then": [
                        {
                          "toast": "{{ t('issues.cannot_create', 'Only a developer or an admin of the project creates issues') }}"
                        }
                      ],
                      "else": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "toast": "{{ t('issues.created', 'Issue created') }}"
            },
            {
              "navigate": "issue-detail",
              "params": {
                "key": "{{params.key}}",
                "issue": "{{created.key}}"
              }
            }
          ]
        }
      ],
      "fieldsFrom": {
        "source": "newFields",
        "into": "custom",
        "nameField": "key",
        "types": {
          "text": {
            "name": "text",
            "type": "text",
            "width": "l",
            "maxLength": 1000
          },
          "user": {
            "name": "user",
            "type": "lookup",
            "width": "m",
            "lookup": {
              "source": "assignees",
              "valueField": "username",
              "labelField": "username",
              "minChars": 0
            }
          }
        }
      }
    }
  ]
}
