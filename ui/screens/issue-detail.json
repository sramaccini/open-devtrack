{
  "schemaVersion": "1.0",
  "screen": "issue-detail",
  "title": "{{ t('issues.issue', 'Issue') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "issue": {
      "ref": "issues/get"
    },
    "save": {
      "ref": "issues/save"
    },
    "remove": {
      "ref": "issues/remove"
    },
    "assignees": {
      "ref": "issues/assignees"
    },
    "comments": {
      "ref": "issues/comments"
    },
    "addComment": {
      "ref": "issues/addComment"
    },
    "editComment": {
      "ref": "issues/editComment"
    },
    "removeComment": {
      "ref": "issues/removeComment"
    },
    "history": {
      "ref": "issues/history"
    }
  },
  "components": [
    {
      "id": "issue-form",
      "type": "form",
      "source": "issue",
      "columns": 3,
      "fields": [
        {
          "name": "key",
          "type": "text",
          "label": "{{ t('issues.key', 'Key') }}",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "status",
          "type": "select",
          "label": "{{ t('issues.status', 'Status') }}",
          "options": [
            "todo",
            "in_progress",
            "done"
          ],
          "optionKey": "values.status",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "reporter",
          "type": "text",
          "label": "{{ t('issues.reporter', 'Reporter') }}",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "summary",
          "type": "text",
          "label": "{{ t('issues.summary', 'Summary') }}",
          "required": true,
          "maxLength": 255,
          "span": 3,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "type",
          "type": "select",
          "label": "{{ t('issues.type', 'Type') }}",
          "options": [
            "task",
            "bug",
            "story",
            "epic"
          ],
          "optionKey": "values.issue_type",
          "required": true,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "priority",
          "type": "select",
          "label": "{{ t('issues.priority', 'Priority') }}",
          "options": [
            "lowest",
            "low",
            "medium",
            "high",
            "highest"
          ],
          "optionKey": "values.priority",
          "required": true,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "assignee",
          "type": "lookup",
          "label": "{{ t('issues.assignee', 'Assignee') }}",
          "tooltip": "{{ t('issues.assignee_help', 'A member of the project') }}",
          "readOnlyIf": "{{!form._perm.edit}}",
          "lookup": {
            "source": "assignees",
            "valueField": "username",
            "labelField": "username",
            "minChars": 0
          }
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "{{ t('issues.description', 'Description') }}",
          "span": 3,
          "rows": 8,
          "readOnlyIf": "{{!form._perm.edit}}"
        }
      ],
      "actions": [
        {
          "id": "btn-save",
          "label": "{{ t('common.save', 'Save') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "call": "save",
              "onError": [
                {
                  "if": "{{error.status == 412}}",
                  "then": [
                    {
                      "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                    }
                  ],
                  "else": [
                    {
                      "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "issue"
            },
            {
              "refresh": "history"
            },
            {
              "toast": "{{ t('common.saved', 'Saved') }}"
            }
          ]
        },
        {
          "id": "btn-comment",
          "label": "{{ t('issues.add_comment', 'Comment') }}",
          "visibleIf": "{{form._perm.comment}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('issues.add_comment', 'Comment') }}",
                "submitLabel": "{{ t('issues.post', 'Post') }}",
                "fields": [
                  {
                    "name": "body",
                    "type": "richtext",
                    "label": "{{ t('issues.comment', 'Comment') }}",
                    "required": true,
                    "rows": 6
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addComment",
                    "onError": [
                      {
                        "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "comments"
            }
          ]
        },
        {
          "id": "btn-back",
          "label": "{{ t('issues.all', 'All issues') }}",
          "onClick": [
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{params.key}}"
              }
            }
          ]
        },
        {
          "id": "btn-delete",
          "label": "{{ t('issues.delete', 'Delete') }}",
          "visibleIf": "{{form._perm.delete}}",
          "onClick": [
            {
              "confirm": "{{ t('issues.delete_confirm', 'Delete {key}? It cannot be undone.', {'key': form.key}) }}"
            },
            {
              "call": "remove",
              "onError": [
                {
                  "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                }
              ]
            },
            {
              "toast": "{{ t('issues.deleted', 'Issue deleted') }}"
            },
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{params.key}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "issue-tabs",
      "type": "tabs",
      "tabs": [
        {
          "id": "tab-comments",
          "label": "{{ t('issues.comments', 'Comments') }}",
          "components": [
            {
              "id": "comment-table",
              "type": "table",
              "source": "comments",
              "columns": [
                {
                  "field": "author",
                  "label": "{{ t('issues.author', 'Author') }}"
                },
                {
                  "field": "body",
                  "label": "{{ t('issues.comment', 'Comment') }}",
                  "format": "markdown"
                },
                {
                  "field": "createdAt",
                  "label": "{{ t('issues.when', 'When') }}",
                  "format": "datetime"
                }
              ],
              "rowActions": [
                {
                  "id": "btn-edit-comment",
                  "label": "{{ t('issues.edit', 'Edit') }}",
                  "visibleIf": "{{row._perm.edit}}",
                  "onClick": [
                    {
                      "dialog": {
                        "title": "{{ t('issues.edit_comment', 'Edit comment') }}",
                        "submitLabel": "{{ t('common.save', 'Save') }}",
                        "initial": {
                          "body": "{{row.body}}",
                          "version": "{{row.version}}"
                        },
                        "fields": [
                          {
                            "name": "body",
                            "type": "richtext",
                            "label": "{{ t('issues.comment', 'Comment') }}",
                            "required": true,
                            "rows": 6
                          }
                        ],
                        "onSubmit": [
                          {
                            "call": "editComment",
                            "args": {
                              "id": "{{row.id}}"
                            },
                            "onError": [
                              {
                                "if": "{{error.status == 412}}",
                                "then": [
                                  {
                                    "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                                  }
                                ],
                                "else": [
                                  {
                                    "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "refresh": "comments"
                    }
                  ]
                },
                {
                  "id": "btn-delete-comment",
                  "label": "{{ t('issues.delete', 'Delete') }}",
                  "visibleIf": "{{row._perm.delete}}",
                  "onClick": [
                    {
                      "confirm": "{{ t('issues.delete_comment_confirm', 'Delete this comment?') }}"
                    },
                    {
                      "call": "removeComment",
                      "args": {
                        "id": "{{row.id}}"
                      },
                      "onError": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    },
                    {
                      "refresh": "comments"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tab-history",
          "label": "{{ t('issues.history', 'History') }}",
          "components": [
            {
              "id": "history-table",
              "type": "table",
              "source": "history",
              "columns": [
                {
                  "field": "at",
                  "label": "{{ t('issues.when', 'When') }}",
                  "format": "datetime"
                },
                {
                  "field": "author",
                  "label": "{{ t('issues.author', 'Author') }}"
                },
                {
                  "field": "field",
                  "label": "{{ t('issues.field', 'Field') }}",
                  "valueKey": "values.issue_field"
                },
                {
                  "field": "from",
                  "label": "{{ t('issues.from', 'From') }}"
                },
                {
                  "field": "to",
                  "label": "{{ t('issues.to', 'To') }}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
