{
  "schemaVersion": "1.0",
  "screen": "issue-detail",
  "title": "{{ t('issues.issue', 'Issue') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "issue": {
      "ref": "issues/get"
    },
    "save": {
      "ref": "issues/save"
    },
    "remove": {
      "ref": "issues/remove"
    },
    "assignees": {
      "ref": "issues/assignees"
    },
    "comments": {
      "ref": "issues/comments"
    },
    "addComment": {
      "ref": "issues/addComment"
    },
    "editComment": {
      "ref": "issues/editComment"
    },
    "removeComment": {
      "ref": "issues/removeComment"
    },
    "history": {
      "ref": "issues/history"
    },
    "transitions": {
      "ref": "issues/transitions"
    },
    "move": {
      "ref": "issues/move"
    },
    "links": {
      "ref": "issues/links"
    },
    "linkCandidates": {
      "ref": "issues/linkCandidates"
    },
    "addLink": {
      "ref": "issues/addLink"
    },
    "removeLink": {
      "ref": "issues/removeLink"
    },
    "watchers": {
      "ref": "issues/watchers"
    },
    "watch": {
      "ref": "issues/watch"
    },
    "unwatch": {
      "ref": "issues/unwatch"
    },
    "addWatcher": {
      "ref": "issues/addWatcher"
    },
    "fields": {
      "ref": "issues/fields"
    }
  },
  "components": [
    {
      "id": "issue-form",
      "type": "form",
      "source": "issue",
      "columns": 3,
      "fields": [
        {
          "name": "key",
          "type": "text",
          "label": "{{ t('issues.key', 'Key') }}",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "status",
          "type": "select",
          "label": "{{ t('issues.status', 'Status') }}",
          "options": [
            "todo",
            "in_progress",
            "done"
          ],
          "optionKey": "values.status",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "reporter",
          "type": "text",
          "label": "{{ t('issues.reporter', 'Reporter') }}",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "summary",
          "type": "text",
          "label": "{{ t('issues.summary', 'Summary') }}",
          "required": true,
          "maxLength": 255,
          "span": 3,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "type",
          "type": "select",
          "label": "{{ t('issues.type', 'Type') }}",
          "options": [
            "task",
            "bug",
            "story",
            "epic"
          ],
          "optionKey": "values.issue_type",
          "required": true,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "priority",
          "type": "select",
          "label": "{{ t('issues.priority', 'Priority') }}",
          "options": [
            "lowest",
            "low",
            "medium",
            "high",
            "highest"
          ],
          "optionKey": "values.priority",
          "required": true,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "assignee",
          "type": "lookup",
          "label": "{{ t('issues.assignee', 'Assignee') }}",
          "tooltip": "{{ t('issues.assignee_help', 'A member of the project') }}",
          "readOnlyIf": "{{!form._perm.edit}}",
          "lookup": {
            "source": "assignees",
            "valueField": "username",
            "labelField": "username",
            "minChars": 0
          }
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "{{ t('issues.description', 'Description') }}",
          "span": 3,
          "rows": 8,
          "readOnlyIf": "{{!form._perm.edit}}"
        }
      ],
      "actions": [
        {
          "id": "btn-save",
          "label": "{{ t('common.save', 'Save') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "call": "save",
              "onError": [
                {
                  "if": "{{error.fields > 0}}",
                  "then": [
                    {
                      "toast": "{{ t('common.check_fields', 'Check the highlighted fields') }}"
                    }
                  ],
                  "else": [
                    {
                      "if": "{{error.status == 412}}",
                      "then": [
                        {
                          "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                        }
                      ],
                      "else": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "issue"
            },
            {
              "refresh": "history"
            },
            {
              "refresh": "transitions"
            },
            {
              "refresh": "fields"
            },
            {
              "toast": "{{ t('common.saved', 'Saved') }}"
            }
          ]
        },
        {
          "id": "btn-comment",
          "label": "{{ t('issues.add_comment', 'Comment') }}",
          "visibleIf": "{{form._perm.comment}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('issues.add_comment', 'Comment') }}",
                "submitLabel": "{{ t('issues.post', 'Post') }}",
                "fields": [
                  {
                    "name": "body",
                    "type": "richtext",
                    "label": "{{ t('issues.comment', 'Comment') }}",
                    "required": true,
                    "rows": 6
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addComment",
                    "onError": [
                      {
                        "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "comments"
            }
          ]
        },
        {
          "id": "btn-link",
          "label": "{{ t('issues.add_link', 'Link') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('issues.add_link_title', 'Link to another issue') }}",
                "submitLabel": "{{ t('issues.add_link', 'Link') }}",
                "initial": {
                  "relation": "relates"
                },
                "fields": [
                  {
                    "name": "relation",
                    "type": "select",
                    "label": "{{ t('issues.relation', 'Relation') }}",
                    "required": true,
                    "options": [
                      "blocks",
                      "blocked_by",
                      "relates",
                      "duplicates",
                      "duplicated_by"
                    ],
                    "optionKey": "values.relation"
                  },
                  {
                    "name": "issue",
                    "type": "lookup",
                    "label": "{{ t('issues.linked_issue', 'Issue') }}",
                    "tooltip": "{{ t('issues.linked_issue_help', 'Its key or words of its summary') }}",
                    "required": true,
                    "lookup": {
                      "source": "linkCandidates",
                      "valueField": "key",
                      "labelField": "label",
                      "minChars": 0
                    }
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addLink",
                    "onError": [
                      {
                        "if": "{{error.status == 409}}",
                        "then": [
                          {
                            "toast": "{{ t('issues.already_linked', 'The issues are already linked this way') }}"
                          }
                        ],
                        "else": [
                          {
                            "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "links"
            },
            {
              "refresh": "history"
            }
          ]
        },
        {
          "id": "btn-watch",
          "label": "{{ t('issues.watch', 'Watch') }}",
          "visibleIf": "{{!form.watching}}",
          "onClick": [
            {
              "call": "watch",
              "onError": [
                {
                  "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                }
              ]
            },
            {
              "refresh": "issue"
            },
            {
              "refresh": "watchers"
            },
            {
              "toast": "{{ t('issues.watching', 'You are watching this issue') }}"
            }
          ]
        },
        {
          "id": "btn-unwatch",
          "label": "{{ t('issues.unwatch', 'Stop watching') }}",
          "visibleIf": "{{form.watching}}",
          "onClick": [
            {
              "call": "unwatch",
              "args": {
                "username": "me"
              },
              "onError": [
                {
                  "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                }
              ]
            },
            {
              "refresh": "issue"
            },
            {
              "refresh": "watchers"
            },
            {
              "toast": "{{ t('issues.not_watching', 'You are no longer watching this issue') }}"
            }
          ]
        },
        {
          "id": "btn-add-watcher",
          "label": "{{ t('issues.add_watcher', 'Add watcher') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('issues.add_watcher', 'Add watcher') }}",
                "submitLabel": "{{ t('projects.add', 'Add') }}",
                "fields": [
                  {
                    "name": "username",
                    "type": "lookup",
                    "label": "{{ t('issues.watcher', 'User') }}",
                    "tooltip": "{{ t('issues.assignee_help', 'A member of the project') }}",
                    "required": true,
                    "lookup": {
                      "source": "assignees",
                      "valueField": "username",
                      "labelField": "username",
                      "minChars": 0
                    }
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addWatcher",
                    "onError": [
                      {
                        "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "watchers"
            },
            {
              "refresh": "issue"
            }
          ]
        },
        {
          "id": "btn-back",
          "label": "{{ t('issues.all', 'All issues') }}",
          "onClick": [
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{params.key}}"
              }
            }
          ]
        },
        {
          "id": "btn-delete",
          "label": "{{ t('issues.delete', 'Delete') }}",
          "visibleIf": "{{form._perm.delete}}",
          "onClick": [
            {
              "confirm": "{{ t('issues.delete_confirm', 'Delete {key}? It cannot be undone.', {'key': form.key}) }}"
            },
            {
              "call": "remove",
              "onError": [
                {
                  "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                }
              ]
            },
            {
              "toast": "{{ t('issues.deleted', 'Issue deleted') }}"
            },
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{params.key}}"
              }
            }
          ]
        }
      ],
      "fieldsFrom": {
        "source": "fields",
        "into": "custom",
        "nameField": "key",
        "types": {
          "text": {
            "name": "text",
            "type": "text",
            "maxLength": 1000,
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "number": {
            "name": "number",
            "type": "number",
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "date": {
            "name": "date",
            "type": "date",
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "checkbox": {
            "name": "checkbox",
            "type": "checkbox",
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "select": {
            "name": "select",
            "type": "select",
            "options": [],
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "multiselect": {
            "name": "multiselect",
            "type": "multiselect",
            "options": [],
            "readOnlyIf": "{{!form._perm.edit}}"
          },
          "user": {
            "name": "user",
            "type": "lookup",
            "lookup": {
              "source": "assignees",
              "valueField": "username",
              "labelField": "username",
              "minChars": 0
            },
            "readOnlyIf": "{{!form._perm.edit}}"
          }
        }
      }
    },
    {
      "id": "workflow-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('issues.next_steps', 'Next steps') }}"
    },
    {
      "id": "transition-table",
      "type": "table",
      "source": "transitions",
      "columns": [
        {
          "field": "code",
          "label": "{{ t('issues.transition', 'Transition') }}",
          "valueKey": "values.transition"
        },
        {
          "field": "to",
          "label": "{{ t('issues.to_status', 'To status') }}",
          "valueKey": "values.status"
        }
      ],
      "rowActions": [
        {
          "id": "btn-move",
          "label": "{{ t('issues.move', 'Move') }}",
          "onClick": [
            {
              "call": "move",
              "args": {
                "transition": "{{row.code}}",
                "version": "{{row.version}}"
              },
              "onError": [
                {
                  "if": "{{error.status == 409}}",
                  "then": [
                    {
                      "toast": "{{ t('issues.conditions_not_met', 'The conditions of this step are not met') }}"
                    }
                  ],
                  "else": [
                    {
                      "if": "{{error.status == 412}}",
                      "then": [
                        {
                          "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                        }
                      ],
                      "else": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "issue"
            },
            {
              "refresh": "transitions"
            },
            {
              "refresh": "history"
            },
            {
              "toast": "{{ t('issues.moved', 'Status changed') }}"
            }
          ]
        }
      ]
    },
    {
      "id": "issue-tabs",
      "type": "tabs",
      "tabs": [
        {
          "id": "tab-comments",
          "label": "{{ t('issues.comments', 'Comments') }}",
          "components": [
            {
              "id": "comment-table",
              "type": "table",
              "source": "comments",
              "columns": [
                {
                  "field": "author",
                  "label": "{{ t('issues.author', 'Author') }}"
                },
                {
                  "field": "body",
                  "label": "{{ t('issues.comment', 'Comment') }}",
                  "format": "markdown"
                },
                {
                  "field": "createdAt",
                  "label": "{{ t('issues.when', 'When') }}",
                  "format": "datetime"
                }
              ],
              "rowActions": [
                {
                  "id": "btn-edit-comment",
                  "label": "{{ t('issues.edit', 'Edit') }}",
                  "visibleIf": "{{row._perm.edit}}",
                  "onClick": [
                    {
                      "dialog": {
                        "title": "{{ t('issues.edit_comment', 'Edit comment') }}",
                        "submitLabel": "{{ t('common.save', 'Save') }}",
                        "initial": {
                          "body": "{{row.body}}",
                          "version": "{{row.version}}"
                        },
                        "fields": [
                          {
                            "name": "body",
                            "type": "richtext",
                            "label": "{{ t('issues.comment', 'Comment') }}",
                            "required": true,
                            "rows": 6
                          }
                        ],
                        "onSubmit": [
                          {
                            "call": "editComment",
                            "args": {
                              "id": "{{row.id}}"
                            },
                            "onError": [
                              {
                                "if": "{{error.status == 412}}",
                                "then": [
                                  {
                                    "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                                  }
                                ],
                                "else": [
                                  {
                                    "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "refresh": "comments"
                    }
                  ]
                },
                {
                  "id": "btn-delete-comment",
                  "label": "{{ t('issues.delete', 'Delete') }}",
                  "visibleIf": "{{row._perm.delete}}",
                  "onClick": [
                    {
                      "confirm": "{{ t('issues.delete_comment_confirm', 'Delete this comment?') }}"
                    },
                    {
                      "call": "removeComment",
                      "args": {
                        "id": "{{row.id}}"
                      },
                      "onError": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    },
                    {
                      "refresh": "comments"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tab-links",
          "label": "{{ t('issues.links', 'Links') }}",
          "components": [
            {
              "id": "link-table",
              "type": "table",
              "source": "links",
              "columns": [
                {
                  "field": "relation",
                  "label": "{{ t('issues.relation', 'Relation') }}",
                  "valueKey": "values.relation"
                },
                {
                  "field": "key",
                  "label": "{{ t('issues.key', 'Key') }}",
                  "onClick": [
                    {
                      "navigate": "issue-detail",
                      "params": {
                        "key": "{{row.project}}",
                        "issue": "{{row.key}}"
                      }
                    }
                  ]
                },
                {
                  "field": "summary",
                  "label": "{{ t('issues.summary', 'Summary') }}"
                },
                {
                  "field": "status",
                  "label": "{{ t('issues.status', 'Status') }}",
                  "format": "badge",
                  "badges": {
                    "todo": "neutral",
                    "in_progress": "primary",
                    "done": "success"
                  },
                  "valueKey": "values.status"
                }
              ],
              "rowActions": [
                {
                  "id": "btn-remove-link",
                  "label": "{{ t('issues.remove_link', 'Remove') }}",
                  "visibleIf": "{{row._perm.delete}}",
                  "onClick": [
                    {
                      "confirm": "{{ t('issues.remove_link_confirm', 'Remove the link to {key}?', {'key': row.key}) }}"
                    },
                    {
                      "call": "removeLink",
                      "args": {
                        "id": "{{row.id}}"
                      },
                      "onError": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    },
                    {
                      "refresh": "links"
                    },
                    {
                      "refresh": "history"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tab-watchers",
          "label": "{{ t('issues.watchers', 'Watchers') }}",
          "components": [
            {
              "id": "watcher-table",
              "type": "table",
              "source": "watchers",
              "columns": [
                {
                  "field": "username",
                  "label": "{{ t('issues.watcher', 'User') }}"
                },
                {
                  "field": "since",
                  "label": "{{ t('issues.since', 'Since') }}",
                  "format": "datetime"
                }
              ],
              "rowActions": [
                {
                  "id": "btn-remove-watcher",
                  "label": "{{ t('issues.remove_link', 'Remove') }}",
                  "visibleIf": "{{row._perm.delete}}",
                  "onClick": [
                    {
                      "call": "unwatch",
                      "args": {
                        "username": "{{row.username}}"
                      },
                      "onError": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    },
                    {
                      "refresh": "watchers"
                    },
                    {
                      "refresh": "issue"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tab-history",
          "label": "{{ t('issues.history', 'History') }}",
          "components": [
            {
              "id": "history-table",
              "type": "table",
              "source": "history",
              "columns": [
                {
                  "field": "at",
                  "label": "{{ t('issues.when', 'When') }}",
                  "format": "datetime"
                },
                {
                  "field": "author",
                  "label": "{{ t('issues.author', 'Author') }}"
                },
                {
                  "field": "field",
                  "label": "{{ t('issues.field', 'Field') }}",
                  "valueKey": "values.issue_field"
                },
                {
                  "field": "from",
                  "label": "{{ t('issues.from', 'From') }}"
                },
                {
                  "field": "to",
                  "label": "{{ t('issues.to', 'To') }}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
