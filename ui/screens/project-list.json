{
  "schemaVersion": "1.0",
  "screen": "project-list",
  "title": "{{ t('projects.title', 'Projects') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "projects": {
      "ref": "projects/list"
    }
  },
  "components": [
    {
      "id": "toolbar",
      "type": "box",
      "direction": "row",
        "align": "center",
      "components": [
        {
          "id": "title",
          "type": "text",
          "style": "heading",
          "grow": 1,
          "text": "{{ t('projects.title', 'Projects') }}"
        },
        {
          "id": "btn-new",
          "type": "button",
          "label": "{{ t('projects.new', 'New project') }}",
          "visibleIf": "{{can('odt.project.create')}}",
          "onClick": [
            {
              "navigate": "project-new"
            }
          ]
        }
      ]
    },
    {
      "id": "project-table",
      "type": "table",
      "source": "projects",
      "columns": [
        {
          "field": "key",
          "label": "{{ t('projects.key', 'Key') }}",
          "sortable": true,
          "onClick": [
            {
              "navigate": "project-detail",
              "params": {
                "key": "{{row.key}}"
              }
            }
          ]
        },
        {
          "field": "name",
          "label": "{{ t('projects.name', 'Name') }}",
          "sortable": true
        },
        {
          "field": "lead",
          "label": "{{ t('projects.lead', 'Lead') }}"
        },
        {
          "field": "role",
          "label": "{{ t('projects.my_role', 'My role') }}",
          "valueKey": "values.role"
        }
      ],
      "rowActions": [
        {
          "id": "btn-open",
          "label": "{{ t('common.open', 'Open') }}",
          "onClick": [
            {
              "navigate": "project-detail",
              "params": {
                "key": "{{row.key}}"
              }
            }
          ]
        }
      ]
    }
  ]
}
