{
  "schemaVersion": "1.0",
  "screen": "workflow-detail",
  "title": "{{ t('projects.workflow', 'Workflow') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "workflow": {
      "ref": "workflows/get"
    },
    "save": {
      "ref": "workflows/save"
    },
    "transitions": {
      "ref": "workflows/transitions"
    },
    "changeTransition": {
      "ref": "workflows/changeTransition"
    },
    "addTransition": {
      "ref": "workflows/addTransition"
    },
    "removeTransition": {
      "ref": "workflows/removeTransition"
    },
    "statuses": {
      "ref": "workflows/statuses"
    },
    "statusOptions": {
      "ref": "workflows/statusOptions"
    },
    "addStatus": {
      "ref": "workflows/addStatus"
    },
    "changeStatus": {
      "ref": "workflows/changeStatus"
    },
    "removeStatus": {
      "ref": "workflows/removeStatus"
    }
  },
  "components": [
    {
      "id": "workflow-form",
      "type": "form",
      "layout": "flow",
      "source": "workflow",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "label": "{{ t('projects.workflow_name', 'Name') }}",
          "width": "m",
          "required": true,
          "maxLength": 100,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "default",
          "type": "switch",
          "label": "{{ t('projects.workflow_default', 'Default') }}",
          "readOnlyIf": "{{true}}",
          "tooltip": "{{ t('projects.workflow_default_help', 'It serves the issue types that no other workflow maps') }}"
        },
        {
          "name": "types",
          "type": "multiselect",
          "label": "{{ t('projects.workflow_types', 'Issue types') }}",
          "options": [
            "task",
            "bug",
            "story",
            "epic"
          ],
          "optionKey": "values.issue_type",
          "readOnlyIf": "{{!form._perm.types}}",
          "tooltip": "{{ t('projects.workflow_types_help', 'The issues of these types follow this workflow; a type taken from another workflow keeps its status, or moves to the first one of the same category') }}"
        }
      ],
      "actions": [
        {
          "id": "btn-save-workflow",
          "label": "{{ t('common.save', 'Save') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "call": "save",
              "onError": [
                {
                  "if": "{{error.status == 412}}",
                  "then": [
                    {
                      "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                    }
                  ],
                  "else": [
                    {
                      "if": "{{error.status == 409}}",
                      "then": [
                        {
                          "toast": "{{ t('projects.workflow_exists', 'The project already has a workflow with this name') }}"
                        }
                      ],
                      "else": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "workflow"
            },
            {
              "toast": "{{ t('projects.workflow_saved', 'Saved: the issues of the types it took or gave back follow their new workflow') }}"
            }
          ]
        },
        {
          "id": "btn-add-status",
          "label": "{{ t('projects.add_status', 'New status') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.add_status', 'New status') }}",
                "submitLabel": "{{ t('projects.add', 'Add') }}",
                "initial": {
                  "category": "in_progress"
                },
                "fields": [
                  {
                    "name": "code",
                    "type": "text",
                    "label": "{{ t('projects.code', 'Code') }}",
                    "required": true,
                    "pattern": "^[a-z][a-z0-9_]{0,49}$",
                    "tooltip": "{{ t('projects.code_help', 'Lower-case letters, digits and _, from a letter; it does not change') }}"
                  },
                  {
                    "name": "category",
                    "type": "select",
                    "label": "{{ t('projects.category', 'Category') }}",
                    "required": true,
                    "options": [
                      "todo",
                      "in_progress",
                      "done"
                    ],
                    "optionKey": "values.category",
                    "tooltip": "{{ t('projects.category_help', 'Groups the status on boards and reports') }}"
                  },
                  {
                    "name": "position",
                    "type": "number",
                    "label": "{{ t('projects.position', 'Position') }}",
                    "min": 1,
                    "integer": true,
                    "tooltip": "{{ t('projects.position_help', 'From 1: the first status is the one of new issues, in the category To do') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addStatus",
                    "onError": [
                      {
                        "if": "{{error.status == 400}}",
                        "then": [
                          {
                            "toast": "{{ t('projects.status_invalid', 'Check the code, the category and the position: the first status is To do, each category keeps a status, a code has the same category in every workflow') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 409}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.status_exists', 'The workflow already has a status with this code') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "workflow"
            },
            {
              "refresh": "statuses"
            },
            {
              "refresh": "transitions"
            }
          ]
        },
        {
          "id": "btn-add-transition",
          "label": "{{ t('projects.add_transition', 'New transition') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.add_transition', 'New transition') }}",
                "submitLabel": "{{ t('projects.add', 'Add') }}",
                "fields": [
                  {
                    "name": "code",
                    "type": "text",
                    "label": "{{ t('projects.code', 'Code') }}",
                    "required": true,
                    "pattern": "^[a-z][a-z0-9_]{0,49}$",
                    "tooltip": "{{ t('projects.code_help', 'Lower-case letters, digits and _, from a letter; it does not change') }}"
                  },
                  {
                    "name": "from",
                    "type": "lookup",
                    "label": "{{ t('projects.from_status', 'From status') }}",
                    "tooltip": "{{ t('projects.from_status_help', 'Empty: from every status') }}",
                    "lookup": {
                      "source": "statusOptions",
                      "valueField": "code",
                      "labelField": "code",
                      "minChars": 0
                    }
                  },
                  {
                    "name": "to",
                    "type": "lookup",
                    "label": "{{ t('issues.to_status', 'To status') }}",
                    "required": true,
                    "lookup": {
                      "source": "statusOptions",
                      "valueField": "code",
                      "labelField": "code",
                      "minChars": 0
                    }
                  },
                  {
                    "name": "guard",
                    "type": "textarea",
                    "rows": 3,
                    "maxLength": 1000,
                    "label": "{{ t('projects.condition', 'Condition') }}",
                    "tooltip": "{{ t('projects.condition_help', 'A CEL expression on issue and user, for example issue.assignee != null; empty for none') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addTransition",
                    "onError": [
                      {
                        "if": "{{error.status == 400}}",
                        "then": [
                          {
                            "toast": "{{ t('projects.transition_invalid', 'Check from, to and the condition: two different statuses, the condition in CEL') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 409}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.transition_exists', 'The workflow already has a transition with this code') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "transitions"
            }
          ]
        },
        {
          "id": "btn-project",
          "label": "{{ t('projects.project', 'Project') }}",
          "onClick": [
            {
              "navigate": "project-detail",
              "params": {
                "key": "{{params.key}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "statuses-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('projects.statuses', 'Statuses') }}"
    },
    {
      "id": "status-table",
      "type": "table",
      "source": "statuses",
      "columns": [
        {
          "field": "position",
          "label": "{{ t('projects.position', 'Position') }}"
        },
        {
          "field": "code",
          "label": "{{ t('issues.status', 'Status') }}",
          "valueKey": "values.status"
        },
        {
          "field": "category",
          "label": "{{ t('projects.category', 'Category') }}",
          "valueKey": "values.category"
        },
        {
          "field": "issues",
          "label": "{{ t('projects.status_issues', 'Issues') }}"
        }
      ],
      "rowActions": [
        {
          "id": "btn-edit-status",
          "label": "{{ t('common.edit', 'Edit') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.edit_status', 'Edit status') }}",
                "submitLabel": "{{ t('common.save', 'Save') }}",
                "initial": {
                  "category": "{{row.category}}",
                  "position": "{{row.position}}",
                  "version": "{{row.version}}"
                },
                "fields": [
                  {
                    "name": "category",
                    "type": "select",
                    "label": "{{ t('projects.category', 'Category') }}",
                    "required": true,
                    "options": [
                      "todo",
                      "in_progress",
                      "done"
                    ],
                    "optionKey": "values.category",
                    "tooltip": "{{ t('projects.category_help', 'Groups the status on boards and reports') }}"
                  },
                  {
                    "name": "position",
                    "type": "number",
                    "label": "{{ t('projects.position', 'Position') }}",
                    "min": 1,
                    "integer": true,
                    "tooltip": "{{ t('projects.position_help', 'From 1: the first status is the one of new issues, in the category To do') }}",
                    "required": true
                  }
                ],
                "onSubmit": [
                  {
                    "call": "changeStatus",
                    "args": {
                      "code": "{{row.code}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 412}}",
                        "then": [
                          {
                            "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 400}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.status_invalid', 'Check the code, the category and the position: the first status is To do, each category keeps a status, a code has the same category in every workflow') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "workflow"
            },
            {
              "refresh": "statuses"
            },
            {
              "refresh": "transitions"
            }
          ]
        },
        {
          "id": "btn-remove-status",
          "label": "{{ t('projects.remove', 'Remove') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.remove_status', 'Remove status') }}",
                "submitLabel": "{{ t('projects.remove', 'Remove') }}",
                "initial": {
                  "version": "{{row.version}}"
                },
                "fields": [
                  {
                    "name": "moveTo",
                    "type": "lookup",
                    "label": "{{ t('projects.move_to', 'Move its issues to') }}",
                    "tooltip": "{{ t('projects.move_to_help', 'The issues of the removed status go there; the transitions from or to it are removed too') }}",
                    "required": true,
                    "lookup": {
                      "source": "statusOptions",
                      "valueField": "code",
                      "labelField": "code",
                      "minChars": 0
                    }
                  }
                ],
                "onSubmit": [
                  {
                    "call": "removeStatus",
                    "args": {
                      "code": "{{row.code}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 412}}",
                        "then": [
                          {
                            "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 400}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.status_invalid', 'Check the code, the category and the position: the first status is To do, each category keeps a status, a code has the same category in every workflow') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "workflow"
            },
            {
              "refresh": "statuses"
            },
            {
              "refresh": "transitions"
            },
            {
              "toast": "{{ t('projects.status_removed', 'Status removed, its issues moved') }}"
            }
          ]
        }
      ]
    },
    {
      "id": "transitions-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('projects.transitions', 'Transitions') }}"
    },
    {
      "id": "workflow-table",
      "type": "table",
      "source": "transitions",
      "columns": [
        {
          "field": "code",
          "label": "{{ t('issues.transition', 'Transition') }}",
          "valueKey": "values.transition"
        },
        {
          "field": "from",
          "label": "{{ t('projects.from_status', 'From status') }}",
          "valueKey": "values.status"
        },
        {
          "field": "to",
          "label": "{{ t('issues.to_status', 'To status') }}",
          "valueKey": "values.status"
        },
        {
          "field": "guard",
          "label": "{{ t('projects.condition', 'Condition') }}"
        }
      ],
      "rowActions": [
        {
          "id": "btn-edit-transition",
          "label": "{{ t('common.edit', 'Edit') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.edit_transition', 'Edit transition') }}",
                "submitLabel": "{{ t('common.save', 'Save') }}",
                "initial": {
                  "from": "{{row.from}}",
                  "to": "{{row.to}}",
                  "guard": "{{row.guard}}",
                  "version": "{{row.version}}"
                },
                "fields": [
                  {
                    "name": "from",
                    "type": "lookup",
                    "label": "{{ t('projects.from_status', 'From status') }}",
                    "tooltip": "{{ t('projects.from_status_help', 'Empty: from every status') }}",
                    "lookup": {
                      "source": "statusOptions",
                      "valueField": "code",
                      "labelField": "code",
                      "minChars": 0
                    }
                  },
                  {
                    "name": "to",
                    "type": "lookup",
                    "label": "{{ t('issues.to_status', 'To status') }}",
                    "required": true,
                    "lookup": {
                      "source": "statusOptions",
                      "valueField": "code",
                      "labelField": "code",
                      "minChars": 0
                    }
                  },
                  {
                    "name": "guard",
                    "type": "textarea",
                    "rows": 3,
                    "maxLength": 1000,
                    "label": "{{ t('projects.condition', 'Condition') }}",
                    "tooltip": "{{ t('projects.condition_help', 'A CEL expression on issue and user, for example issue.assignee != null; empty for none') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "changeTransition",
                    "args": {
                      "code": "{{row.code}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 412}}",
                        "then": [
                          {
                            "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 400}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.transition_invalid', 'Check from, to and the condition: two different statuses, the condition in CEL') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "workflow"
            },
            {
              "refresh": "statuses"
            },
            {
              "refresh": "transitions"
            }
          ]
        },
        {
          "id": "btn-remove-transition",
          "label": "{{ t('projects.remove', 'Remove') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "confirm": "{{ t('projects.remove_transition_confirm', 'Remove the transition {code}? The issues stay where they are.', {'code': row.code}) }}"
            },
            {
              "call": "removeTransition",
              "args": {
                "code": "{{row.code}}",
                "version": "{{row.version}}"
              },
              "onError": [
                {
                  "if": "{{error.status == 412}}",
                  "then": [
                    {
                      "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                    }
                  ],
                  "else": [
                    {
                      "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "workflow"
            },
            {
              "refresh": "statuses"
            },
            {
              "refresh": "transitions"
            }
          ]
        }
      ]
    }
  ]
}
