{
  "schemaVersion": "1.0",
  "screen": "project-detail",
  "title": "{{ t('projects.project', 'Project') }}",
  "requires": "odt.project.browse",
  "dataSources": {
    "project": {
      "ref": "projects/get"
    },
    "save": {
      "ref": "projects/save"
    },
    "members": {
      "ref": "projects/members"
    },
    "addMember": {
      "ref": "projects/addMember"
    },
    "changeRole": {
      "ref": "projects/changeRole"
    },
    "removeMember": {
      "ref": "projects/removeMember"
    },
    "users": {
      "ref": "users/search"
    },
    "transitions": {
      "ref": "projects/transitions"
    },
    "setGuard": {
      "ref": "projects/setGuard"
    },
    "fieldDefinitions": {
      "ref": "projects/fieldDefinitions"
    },
    "addField": {
      "ref": "projects/addField"
    },
    "saveField": {
      "ref": "projects/saveField"
    }
  },
  "components": [
    {
      "id": "project-form",
      "type": "form",
      "source": "project",
      "columns": 2,
      "fields": [
        {
          "name": "key",
          "type": "text",
          "label": "{{ t('projects.key', 'Key') }}",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "name",
          "type": "text",
          "label": "{{ t('projects.name', 'Name') }}",
          "required": true,
          "maxLength": 100,
          "readOnlyIf": "{{!form._perm.edit}}"
        },
        {
          "name": "lead",
          "type": "text",
          "label": "{{ t('projects.lead', 'Lead') }}",
          "required": true,
          "readOnlyIf": "{{!form._perm.edit}}",
          "tooltip": "{{ t('projects.lead_help', 'A member of the project') }}"
        },
        {
          "name": "role",
          "type": "select",
          "label": "{{ t('projects.my_role', 'My role') }}",
          "options": [
            "viewer",
            "developer",
            "admin"
          ],
          "optionKey": "values.role",
          "readOnlyIf": "{{true}}"
        },
        {
          "name": "description",
          "type": "textarea",
          "label": "{{ t('projects.description', 'Description') }}",
          "maxLength": 2000,
          "span": 2,
          "readOnlyIf": "{{!form._perm.edit}}"
        }
      ],
      "actions": [
        {
          "id": "btn-save",
          "label": "{{ t('common.save', 'Save') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "call": "save",
              "onError": [
                {
                  "if": "{{error.status == 412}}",
                  "then": [
                    {
                      "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                    }
                  ],
                  "else": [
                    {
                      "if": "{{error.status == 400}}",
                      "then": [
                        {
                          "toast": "{{ t('projects.lead_not_member', 'Check the fields: the lead must be a member of the project') }}"
                        }
                      ],
                      "else": [
                        {
                          "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "project"
            },
            {
              "toast": "{{ t('common.saved', 'Saved') }}"
            }
          ]
        },
        {
          "id": "btn-add-member",
          "label": "{{ t('projects.add_member', 'Add member') }}",
          "visibleIf": "{{form._perm.manageMembers}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.add_member', 'Add member') }}",
                "submitLabel": "{{ t('projects.add', 'Add') }}",
                "initial": {
                  "role": "developer"
                },
                "fields": [
                  {
                    "name": "username",
                    "type": "lookup",
                    "label": "{{ t('projects.user', 'User') }}",
                    "required": true,
                    "lookup": {
                      "source": "users",
                      "valueField": "username",
                      "labelField": "username",
                      "minChars": 1
                    }
                  },
                  {
                    "name": "role",
                    "type": "select",
                    "label": "{{ t('projects.role', 'Role') }}",
                    "options": [
                      "viewer",
                      "developer",
                      "admin"
                    ],
                    "optionKey": "values.role",
                    "required": true
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addMember",
                    "onError": [
                      {
                        "toast": "{{ t('projects.member_failed', 'The member could not be added') }}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "members"
            },
            {
              "toast": "{{ t('projects.member_added', 'Member added') }}"
            }
          ]
        },
        {
          "id": "btn-add-field",
          "label": "{{ t('projects.add_field', 'New field') }}",
          "visibleIf": "{{form._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.add_field', 'New field') }}",
                "submitLabel": "{{ t('projects.add', 'Add') }}",
                "initial": {
                  "type": "text"
                },
                "fields": [
                  {
                    "name": "key",
                    "type": "text",
                    "label": "{{ t('projects.field_key', 'Key') }}",
                    "required": true,
                    "pattern": "^[a-z][a-z0-9_]{0,39}$",
                    "tooltip": "{{ t('projects.field_key_help', 'Lower-case letters, digits and _, from a letter; it does not change') }}"
                  },
                  {
                    "name": "type",
                    "type": "select",
                    "label": "{{ t('projects.field_type', 'Type') }}",
                    "required": true,
                    "options": [
                      "text",
                      "number",
                      "date",
                      "checkbox",
                      "select",
                      "multiselect",
                      "user"
                    ],
                    "optionKey": "values.field_type"
                  },
                  {
                    "name": "label",
                    "type": "text",
                    "label": "{{ t('projects.field_label', 'Label') }}",
                    "required": true,
                    "maxLength": 100
                  },
                  {
                    "name": "options",
                    "type": "textarea",
                    "label": "{{ t('projects.field_options', 'Options') }}",
                    "rows": 4,
                    "tooltip": "{{ t('projects.field_options_help', 'For select and multiselect: one per line, value or value: Label') }}"
                  },
                  {
                    "name": "requiredIf",
                    "type": "text",
                    "label": "{{ t('projects.field_required_if', 'Required when') }}",
                    "maxLength": 1000,
                    "tooltip": "{{ t('projects.field_required_if_help', 'A CEL expression on issue and user, for example issue.type == \"bug\"; true for always, empty for never') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "addField",
                    "onError": [
                      {
                        "if": "{{error.status == 400}}",
                        "then": [
                          {
                            "toast": "{{ t('projects.field_invalid', 'Check the key, the options and the rule') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 409}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.field_exists', 'The project already has a field with this key') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "fieldDefinitions"
            }
          ]
        },
        {
          "id": "btn-issues",
          "label": "{{ t('issues.title', 'Issues') }}",
          "onClick": [
            {
              "navigate": "issue-list",
              "params": {
                "key": "{{form.key}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "members-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('projects.members', 'Members') }}"
    },
    {
      "id": "member-table",
      "type": "table",
      "source": "members",
      "columns": [
        {
          "field": "username",
          "label": "{{ t('projects.user', 'User') }}"
        },
        {
          "field": "role",
          "label": "{{ t('projects.role', 'Role') }}",
          "valueKey": "values.role"
        },
        {
          "field": "grantedBy",
          "label": "{{ t('projects.granted_by', 'Added by') }}"
        }
      ],
      "rowActions": [
        {
          "id": "btn-change-role",
          "label": "{{ t('projects.change_role', 'Change role') }}",
          "visibleIf": "{{row._perm.change}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.change_role', 'Change role') }}",
                "initial": {
                  "role": "{{row.role}}"
                },
                "fields": [
                  {
                    "name": "role",
                    "type": "select",
                    "label": "{{ t('projects.role', 'Role') }}",
                    "options": [
                      "viewer",
                      "developer",
                      "admin"
                    ],
                    "optionKey": "values.role",
                    "required": true
                  }
                ],
                "onSubmit": [
                  {
                    "call": "changeRole",
                    "args": {
                      "username": "{{row.username}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 409}}",
                        "then": [
                          {
                            "toast": "{{ t('projects.last_admin', 'A project keeps at least one admin') }}"
                          }
                        ],
                        "else": [
                          {
                            "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "members"
            }
          ]
        },
        {
          "id": "btn-remove",
          "label": "{{ t('projects.remove', 'Remove') }}",
          "visibleIf": "{{row._perm.remove}}",
          "onClick": [
            {
              "confirm": "{{ t('projects.remove_confirm', 'Remove {name} from the project?', {'name': row.username}) }}"
            },
            {
              "call": "removeMember",
              "args": {
                "username": "{{row.username}}"
              },
              "onError": [
                {
                  "if": "{{error.status == 409}}",
                  "then": [
                    {
                      "toast": "{{ t('projects.last_admin', 'A project keeps at least one admin') }}"
                    }
                  ],
                  "else": [
                    {
                      "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                    }
                  ]
                }
              ]
            },
            {
              "refresh": "members"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('projects.workflow', 'Workflow') }}"
    },
    {
      "id": "workflow-table",
      "type": "table",
      "source": "transitions",
      "columns": [
        {
          "field": "code",
          "label": "{{ t('issues.transition', 'Transition') }}",
          "valueKey": "values.transition"
        },
        {
          "field": "from",
          "label": "{{ t('projects.from_status', 'From status') }}",
          "valueKey": "values.status"
        },
        {
          "field": "to",
          "label": "{{ t('issues.to_status', 'To status') }}",
          "valueKey": "values.status"
        },
        {
          "field": "guard",
          "label": "{{ t('projects.condition', 'Condition') }}"
        }
      ],
      "rowActions": [
        {
          "id": "btn-condition",
          "label": "{{ t('projects.edit_condition', 'Edit condition') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.edit_condition', 'Edit condition') }}",
                "submitLabel": "{{ t('common.save', 'Save') }}",
                "initial": {
                  "guard": "{{row.guard}}"
                },
                "fields": [
                  {
                    "name": "guard",
                    "type": "textarea",
                    "rows": 3,
                    "maxLength": 1000,
                    "label": "{{ t('projects.condition', 'Condition') }}",
                    "tooltip": "{{ t('projects.condition_help', 'A CEL expression on issue and user, for example issue.assignee != null; empty for none') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "setGuard",
                    "args": {
                      "code": "{{row.code}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 400}}",
                        "then": [
                          {
                            "toast": "{{ t('projects.condition_invalid', 'The condition is not a valid CEL expression') }}"
                          }
                        ],
                        "else": [
                          {
                            "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "transitions"
            }
          ]
        }
      ]
    },
    {
      "id": "fields-title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('projects.fields', 'Custom fields') }}"
    },
    {
      "id": "field-table",
      "type": "table",
      "source": "fieldDefinitions",
      "columns": [
        {
          "field": "key",
          "label": "{{ t('projects.field_key', 'Key') }}"
        },
        {
          "field": "label",
          "label": "{{ t('projects.field_label', 'Label') }}"
        },
        {
          "field": "type",
          "label": "{{ t('projects.field_type', 'Type') }}",
          "valueKey": "values.field_type"
        },
        {
          "field": "requiredIf",
          "label": "{{ t('projects.field_required_if', 'Required when') }}"
        },
        {
          "field": "archived",
          "label": "{{ t('projects.field_archived', 'Archived') }}",
          "format": "badge",
          "badges": {
            "true": "neutral"
          },
          "valueKey": "values.archived"
        }
      ],
      "rowActions": [
        {
          "id": "btn-edit-field",
          "label": "{{ t('projects.edit_field', 'Edit') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('projects.edit_field_title', 'Edit field') }}",
                "submitLabel": "{{ t('common.save', 'Save') }}",
                "initial": {
                  "label": "{{row.label}}",
                  "options": "{{row.options}}",
                  "requiredIf": "{{row.requiredIf}}",
                  "archived": "{{row.archived}}",
                  "version": "{{row.version}}"
                },
                "fields": [
                  {
                    "name": "label",
                    "type": "text",
                    "label": "{{ t('projects.field_label', 'Label') }}",
                    "required": true,
                    "maxLength": 100
                  },
                  {
                    "name": "options",
                    "type": "textarea",
                    "label": "{{ t('projects.field_options', 'Options') }}",
                    "rows": 4,
                    "tooltip": "{{ t('projects.field_options_help', 'For select and multiselect: one per line, value or value: Label') }}"
                  },
                  {
                    "name": "requiredIf",
                    "type": "text",
                    "label": "{{ t('projects.field_required_if', 'Required when') }}",
                    "maxLength": 1000,
                    "tooltip": "{{ t('projects.field_required_if_help', 'A CEL expression on issue and user, for example issue.type == \"bug\"; true for always, empty for never') }}"
                  },
                  {
                    "name": "archived",
                    "type": "switch",
                    "label": "{{ t('projects.field_archived', 'Archived') }}",
                    "tooltip": "{{ t('projects.field_archived_help', 'Out of the forms; the values stay in the issues') }}"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "saveField",
                    "args": {
                      "fieldKey": "{{row.key}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 412}}",
                        "then": [
                          {
                            "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 400}}",
                            "then": [
                              {
                                "toast": "{{ t('projects.field_invalid', 'Check the key, the options and the rule') }}"
                              }
                            ],
                            "else": [
                              {
                                "if": "{{error.status == 409}}",
                                "then": [
                                  {
                                    "toast": "{{ t('projects.field_exists', 'The project already has a field with this key') }}"
                                  }
                                ],
                                "else": [
                                  {
                                    "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "fieldDefinitions"
            }
          ]
        }
      ]
    }
  ]
}
