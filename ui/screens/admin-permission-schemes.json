{
  "schemaVersion": "1.0",
  "screen": "admin-permission-schemes",
  "title": "{{ t('admin.schemes', 'Permission schemes') }}",
  "requires": "odt.project.admin",
  "dataSources": {
    "schemes": {
      "ref": "admin/schemes"
    },
    "addScheme": {
      "ref": "admin/addScheme"
    },
    "saveScheme": {
      "ref": "admin/saveScheme"
    },
    "removeScheme": {
      "ref": "admin/removeScheme"
    }
  },
  "components": [
    {
      "id": "schemes-help",
      "type": "text",
      "text": "{{ t('admin.schemes_help', 'What each project role gives. A project uses the default scheme until its admin picks another one in the project. Every role sees the issues; the admin always edits the project and manages its members.') }}"
    },
    {
      "id": "btn-add-scheme",
      "type": "button",
      "label": "{{ t('admin.add_scheme', 'New scheme') }}",
      "onClick": [
        {
          "dialog": {
            "title": "{{ t('admin.add_scheme', 'New scheme') }}",
            "submitLabel": "{{ t('projects.add', 'Add') }}",
            "fields": [
              {
                "name": "name",
                "type": "text",
                "label": "{{ t('admin.name', 'Name') }}",
                "required": true,
                "maxLength": 100,
                "tooltip": "{{ t('admin.add_scheme_help', 'It starts as a copy of the default scheme') }}"
              },
              {
                "name": "description",
                "type": "text",
                "label": "{{ t('admin.description', 'Description') }}",
                "maxLength": 500
              }
            ],
            "onSubmit": [
              {
                "call": "addScheme",
                "onError": [
                  {
                    "if": "{{error.status == 409}}",
                    "then": [
                      {
                        "toast": "{{ t('admin.scheme_exists', 'A scheme with this name exists') }}"
                      }
                    ],
                    "else": [
                      {
                        "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "refresh": "schemes"
        }
      ]
    },
    {
      "id": "scheme-table",
      "type": "table",
      "source": "schemes",
      "columns": [
        {
          "field": "name",
          "label": "{{ t('admin.name', 'Name') }}"
        },
        {
          "field": "default",
          "label": "{{ t('admin.default', 'Default') }}",
          "format": "badge",
          "valueKey": "values.yes_no",
          "badges": {
            "true": "primary",
            "false": "neutral"
          }
        },
        {
          "field": "viewer",
          "label": "{{ t('admin.scheme_viewer', 'Viewer') }}",
          "valueKey": "values.project_permission"
        },
        {
          "field": "developer",
          "label": "{{ t('admin.scheme_developer', 'Developer') }}",
          "valueKey": "values.project_permission"
        },
        {
          "field": "admin",
          "label": "{{ t('admin.scheme_admin', 'Admin') }}",
          "valueKey": "values.project_permission"
        },
        {
          "field": "inUse",
          "label": "{{ t('admin.in_use', 'In use') }}",
          "format": "badge",
          "valueKey": "values.yes_no",
          "badges": {
            "true": "success",
            "false": "neutral"
          }
        }
      ],
      "rowActions": [
        {
          "id": "btn-edit-scheme",
          "label": "{{ t('projects.edit_field', 'Edit') }}",
          "visibleIf": "{{row._perm.edit}}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('admin.edit_scheme', 'Edit {name}', {'name': row.name}) }}",
                "submitLabel": "{{ t('common.save', 'Save') }}",
                "initial": {
                  "name": "{{row.name}}",
                  "description": "{{row.description}}",
                  "viewer": "{{row.viewer}}",
                  "developer": "{{row.developer}}",
                  "admin": "{{row.admin}}",
                  "version": "{{row.version}}"
                },
                "fields": [
                  {
                    "name": "name",
                    "type": "text",
                    "label": "{{ t('admin.name', 'Name') }}",
                    "required": true,
                    "maxLength": 100
                  },
                  {
                    "name": "description",
                    "type": "text",
                    "label": "{{ t('admin.description', 'Description') }}",
                    "maxLength": 500
                  },
                  {
                    "name": "viewer",
                    "type": "multiselect",
                    "label": "{{ t('admin.scheme_viewer', 'Viewer') }}",
                    "options": [
                      "odt.issue.browse",
                      "odt.issue.create",
                      "odt.issue.edit",
                      "odt.issue.transition",
                      "odt.issue.comment",
                      "odt.issue.attach",
                      "odt.issue.delete",
                      "odt.sprint.manage",
                      "odt.project.edit",
                      "odt.member.manage"
                    ],
                    "optionKey": "values.project_permission"
                  },
                  {
                    "name": "developer",
                    "type": "multiselect",
                    "label": "{{ t('admin.scheme_developer', 'Developer') }}",
                    "options": [
                      "odt.issue.browse",
                      "odt.issue.create",
                      "odt.issue.edit",
                      "odt.issue.transition",
                      "odt.issue.comment",
                      "odt.issue.attach",
                      "odt.issue.delete",
                      "odt.sprint.manage",
                      "odt.project.edit",
                      "odt.member.manage"
                    ],
                    "optionKey": "values.project_permission"
                  },
                  {
                    "name": "admin",
                    "type": "multiselect",
                    "label": "{{ t('admin.scheme_admin', 'Admin') }}",
                    "options": [
                      "odt.issue.browse",
                      "odt.issue.create",
                      "odt.issue.edit",
                      "odt.issue.transition",
                      "odt.issue.comment",
                      "odt.issue.attach",
                      "odt.issue.delete",
                      "odt.sprint.manage",
                      "odt.project.edit",
                      "odt.member.manage"
                    ],
                    "optionKey": "values.project_permission"
                  }
                ],
                "onSubmit": [
                  {
                    "call": "saveScheme",
                    "args": {
                      "id": "{{row.id}}"
                    },
                    "onError": [
                      {
                        "if": "{{error.status == 412}}",
                        "then": [
                          {
                            "toast": "{{ t('common.changed_meanwhile', 'Someone else changed it in the meantime: reload and try again') }}"
                          }
                        ],
                        "else": [
                          {
                            "if": "{{error.status == 400}}",
                            "then": [
                              {
                                "toast": "{{ t('admin.scheme_rules', 'Every role sees the issues, and the admin always edits the project and manages its members') }}"
                              }
                            ],
                            "else": [
                              {
                                "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "refresh": "schemes"
            }
          ]
        },
        {
          "id": "btn-remove-scheme",
          "label": "{{ t('common.remove', 'Remove') }}",
          "visibleIf": "{{row._perm.remove}}",
          "onClick": [
            {
              "confirm": "{{ t('admin.remove_scheme', 'Remove the scheme {name}?', {'name': row.name}) }}"
            },
            {
              "call": "removeScheme",
              "args": {
                "id": "{{row.id}}"
              },
              "onError": [
                {
                  "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                }
              ]
            },
            {
              "refresh": "schemes"
            }
          ]
        }
      ]
    }
  ]
}
