{
  "schemaVersion": "1.0",
  "navigation": "main",
  "default": "home",
  "notifications": {
    "url": "/api/notifications",
    "readUrl": "/api/notifications/read",
    "refreshSeconds": 60
  },
  "areas": [
    {
      "id": "home",
      "label": "{{ t('nav.home', 'Home') }}",
      "icon": "inbox",
      "items": [
        {
          "id": "dashboard",
          "label": "{{ t('nav.dashboard', 'Dashboard') }}",
          "icon": "inbox",
          "screen": "dashboard"
        },
        {
          "id": "notification-settings",
          "label": "{{ t('nav.notification_settings', 'Notification settings') }}",
          "icon": "settings",
          "screen": "notification-settings"
        }
      ]
    },
    {
      "id": "projects",
      "label": "{{ t('nav.projects', 'Projects') }}",
      "icon": "folder",
      "requires": "odt.project.browse",
      "items": [
        {
          "id": "all-projects",
          "label": "{{ t('nav.all_projects', 'All projects') }}",
          "icon": "list",
          "screen": "project-list"
        },
        {
          "id": "boards",
          "label": "{{ t('nav.boards', 'Boards') }}",
          "icon": "sections",
          "screen": "board-list"
        },
        {
          "id": "search",
          "label": "{{ t('nav.search', 'Search') }}",
          "icon": "search",
          "screen": "search"
        }
      ]
    }
  ]
