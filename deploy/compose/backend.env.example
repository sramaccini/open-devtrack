# The optional settings of the back end (docs/admin/configuration.md). Copy to backend.env and keep only the lines
# that are set: an empty value counts as set for some of them (SPRING_MAIL_HOST would turn mail on with no host).

# Mail (ADR-18): on only when SPRING_MAIL_HOST is set
# SPRING_MAIL_HOST=smtp.example.org
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=opendevtrack
# SPRING_MAIL_PASSWORD=<secret>
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# ODT_MAIL_FROM=OpenDevTrack <tracker@example.org>
# ODT_MAIL_DIGEST_AT=07:00

# Time zone of the days of reports and search dates
# ODT_REPORTING_ZONE=Europe/Rome

# Attachments (ADR-14, ADR-24)
# ODT_ATTACHMENTS_STORE=database
# ODT_ATTACHMENTS_MAX_SIZE=25MB
# ODT_ATTACHMENTS_PROJECT_QUOTA=5GB
# ODT_ATTACHMENTS_SCAN_CLAMD_HOST=clamav

# The key of the secrets in Vault or OpenBao transit (ADR-24)
# ODT_SECRETS_PLUGIN=transit
# ODT_SECRETS_TRANSIT_ADDRESS=https://vault.example.org:8200
# ODT_SECRETS_TRANSIT_TOKEN_FILE=/run/secrets/vault-token

# How long the audit log of the administration is kept
# ODT_AUDIT_RETENTION=P730D
