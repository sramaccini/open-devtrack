# The settings of deploy/compose (docs/admin/installation.md). Copy to .env, set every value, and keep .env out of
# version control and readable only by its owner (chmod 600). No example value works as it is: the secrets must be
# long random strings, for example from: openssl rand -hex 32

# The name of the Compose project, and so of its containers and volumes
ODT_PROJECT=opendevtrack-server

# The optional parts: proxy (Caddy, TLS) and keycloak (an identity provider of its own). Leave out the one the
# installation already has.
COMPOSE_PROFILES=proxy,keycloak

# The image of the back end of a release, by digest (docs/operations/README.md, «Verifying the image»)
ODT_BACKEND_IMAGE=ghcr.io/sramaccini/opendevtrack-backend@sha256:<digest of the release>

# The public name of OpenDevTrack and its address as the browser sees it (with the port when it is not 443)
ODT_HOST=tracker.example.org
ODT_URL=https://tracker.example.org
HTTPS_PORT=443
HTTP_PORT=80

# Keycloak: its public address (the issuer of the tokens) and, with the profile proxy, its name
KEYCLOAK_HOST=login.example.org
KEYCLOAK_URL=https://login.example.org
KEYCLOAK_REALM=opendevtrack

# The client of the BFF and the service account that publishes ui/, with the secrets of the realm
IAM_CLIENT_SECRET=<random>
PUBLISHER_CLIENT_SECRET=<random>
# The clients whose Keycloak tokens the API accepts: the publisher, and the service accounts the installation adds
ODT_BEARER_CLIENTS=opendevtrack-publisher

# PostgreSQL: the superuser of the server, the role of the back end, the role of Keycloak
POSTGRES_PASSWORD=<random>
DB_PASSWORD=<random>
KEYCLOAK_DB_PASSWORD=<random>

# Redis
REDIS_PASSWORD=<random>

# The key of the secrets at rest, at least 32 characters (docs/admin/configuration.md, «Secrets at rest»)
ODT_SECRET_KEY=<random>

# The temporary administrator of the master realm of Keycloak, for the first login only (docs/admin/keycloak.md)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<random>

# Strict-Transport-Security of the pages, for one year
QUADRAVA_HSTS=max-age=31536000

# A GitHub token with read:packages, for the Quadrava CLI that publishes ui/ (./odt.sh publish-ui)
PACKAGES_TOKEN=<token>
