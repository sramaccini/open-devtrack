{
  "realm": "opendevtrack",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "opendevtrack-bff",
      "name": "OpenDevTrack",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${FRONT_URL}/login/oauth2/code/iam"],
      "webOrigins": ["${FRONT_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONT_URL}/*"
      }
    },
    {
      "clientId": "opendevtrack-tools",
      "name": "OpenDevTrack tools (registry)",
      "description": "Command-line tools and people that call /registry/** or /api with a bearer token: the Quadrava CLI, the conformance kit, scripts",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "opendevtrack-ci",
      "name": "OpenDevTrack CI (service account)",
      "description": "A machine that calls /api with the token of its service account (ADR-21): user service-account-opendevtrack-ci",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CI_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "mario.rossi",
      "email": "mario.rossi@example.org",
      "firstName": "Mario",
      "lastName": "Rossi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "anna.bianchi",
      "email": "anna.bianchi@example.org",
      "firstName": "Anna",
      "lastName": "Bianchi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false }]
    }
  ]
}
